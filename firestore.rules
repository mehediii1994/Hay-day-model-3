rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function me(){ return get(/databases/$(d)/documents/shops/main/users/$(request.auth.uid)); }
    function isUser(){ return request.auth != null && exists(/databases/$(d)/documents/shops/main/users/$(request.auth.uid)); }
    function owner(){ return isUser() && me().data.role == 'owner'; }
    match /shops/main/meta/{m} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && m == 'init' && request.resource.data.owner == request.auth.uid;
    }
    match /shops/main/users/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || owner());
      allow create: if request.auth != null && request.auth.uid == u && request.resource.data.role == 'owner'
                    && !exists(/databases/$(d)/documents/shops/main/meta/init);
      allow write: if owner();
    }
    match /shops/main/{s}/{id} {
      allow read: if isUser();
      allow write: if owner() || (isUser() && !(s in ['purchases','expenses','suppliers','settings','users','meta']));
    }
  }
}
